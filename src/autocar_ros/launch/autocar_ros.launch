<?xml version="1.0"?>
<launch>

    <arg name="name"            default="autocar_ros"/>
    <arg name="spawn_x"         default="0"/>
    <arg name="spawn_y"         default="0"/>
    <arg name="spawn_z"         default="0.1"/>
    <arg name="enable_frontcam" default="false"/>
    <arg name="enable_rearcam"  default="false"/>
    <arg name="enable_imu"      default="false"/>
    <arg name="enable_lidar"    default="false"/>
    <arg name="enable_radar"    default="false"/>
    <arg name="teleop_geom"     default="80x17+0-0"/>

    <group ns="$(arg name)">

        <!-- Load robot description from xacro -->
        <param name="robot_description" command="$(find xacro)/xacro '$(find autocar_ros)/urdf/autocar_ros.xacro' 
            ns:=$(arg name) 
            enable_frontcam:=$(arg enable_frontcam) 
            enable_rearcam:=$(arg enable_rearcam) 
            enable_imu:=$(arg enable_imu) 
            enable_lidar:=$(arg enable_lidar) 
            enable_radar:=$(arg enable_radar)"/>

        <!-- ============ SPAWN ============ -->
        <node name="spawn_urdf_$(arg name)" pkg="gazebo_ros" type="spawn_model"
                args="-param robot_description -urdf -model $(arg name) -x $(arg spawn_x) -y $(arg spawn_y) -z $(arg spawn_z)"
                output="screen"/>

        <!-- ============ STATE PUBLISHERS ============ -->
        <node name="joint_state_publisher_$(arg name)" pkg="joint_state_publisher" type="joint_state_publisher">
                <param name="rate" value="10"/>
        </node>

        <node name="robot_state_publisher_$(arg name)" pkg="robot_state_publisher" type="robot_state_publisher">
        </node>

        <!-- ============ TF: map -> <ns>/odom ============ -->
        <node pkg="tf2_ros" type="static_transform_publisher"
                name="map_to_odom_$(arg name)"
                args="0 0 0 0 0 0 map $(arg name)/odom"/>

        <!-- ============ CAMERA OPTICAL FRAMES (only if enabled) ============ -->
        <node if="$(arg enable_frontcam)" pkg="tf2_ros" type="static_transform_publisher"
                name="front_link_to_optical_$(arg name)"
                args="0 0 0 -1.5708 0 -1.5708 $(arg name)/camera_front_link $(arg name)/camera_front_color_optical_frame"/>

        <node if="$(arg enable_rearcam)" pkg="tf2_ros" type="static_transform_publisher"
                name="rear_link_to_optical_$(arg name)"
                args="0 0 0 -1.5708 0 -1.5708 $(arg name)/camera_rear_link $(arg name)/camera_rear_color_optical_frame"/>

        <!-- ============ TELEOP ============ -->
        <node name="manual_drive_$(arg name)" pkg="autocar_ros" type="car_drive.py"
                output="screen"
                args="$(eval ('-ns /' + arg('name')))"
                launch-prefix="xterm -geometry $(arg teleop_geom) -e python3"/>

        <!-- AEB node -->
        <node name="aeb" pkg="autocar_ros" type="aeb.py" output="screen">
            <param name="d_min"       value="0.5"/>
            <param name="ttc_stop"    value="0.6"/>
            <param name="v_close_min" value="0.8"/>
            <param name="d_release"   value="2.0"/>
            <param name="ttc_release" value="1.0"/>
        </node>

    </group>

</launch>
