<?xml version="1.0"?>
<launch>

    <!-- Launch argument: toggle Gazebo GUI on/off -->
    <arg name="gazebo_gui" default="true"/>

    <!-- Start Gazebo with empty world --> 
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="world_name" value="$(find autocar_ros)/worlds/autocar_ros.world"/>
        <arg name="gui" value="$(arg gazebo_gui)"/>
    </include>

    <!-- Load robot description from xacro -->
    <param name="robot_description" command="$(find xacro)/xacro '$(find autocar_ros)/urdf/autocar_ros.xacro'"/>

    <!-- Spawn robot -->
    <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model"
        args="-param robot_description -urdf -model car -x 0 -y 0 -z 0.1" output="screen"/>

   <!-- RViz visualization -->
    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find autocar_ros)/rviz/car.rviz"/>

    <!-- Control node -->
    <node name="manual_drive_node" pkg="autocar_ros" type="car_drive.py" output="screen" launch-prefix="xterm -geometry 80x17+0-0 -e python3"/>

    <!-- AEB node -->
    <node name="aeb" pkg="autocar_ros" type="aeb.py" output="screen">
        <param name="d_min"       value="0.5"/>
        <param name="ttc_stop"    value="0.6"/>
        <param name="v_close_min" value="0.8"/>
        <param name="d_release"   value="2.0"/>
        <param name="ttc_release" value="1.0"/>
    </node>
    
    <!-- Publish joint states -->
    <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher">
        <param name="rate" value="10" />
    </node>
    
    <!-- Robot state publisher with proper rate -->
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"/>

    <node pkg="tf2_ros" type="static_transform_publisher" name="map_to_odom"
        args="0 0 0 0 0 0 map odom" />

    <node name="map_server" pkg="map_server" type="map_server"
          args="$(find autocar_ros)/maps/autocar_ros.yaml"
          output="screen">
        <param name="frame_id" value="map"/>
    </node>
    
    <node pkg="tf2_ros" type="static_transform_publisher" name="front_link_to_optical"
        args="0 0 0 -1.5708 0 -1.5708 camera_front_link camera_front_color_optical_frame" />

    <node pkg="tf2_ros" type="static_transform_publisher" name="rear_link_to_optical"
            args="0 0 0 -1.5708 0 -1.5708 camera_rear_link camera_rear_color_optical_frame"/>


</launch>
