<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="M_PI" value="3.1415926535897931"/>
  <xacro:include filename="$(find velodyne_description)/urdf/VLP-16.urdf.xacro"/>

  <!-- ============================================================= -->
  <!-- 2D LiDAR — outputs sensor_msgs/LaserScan                      -->
  <!-- ============================================================= -->
  <xacro:macro name="lidar_2d"
               params="parent:=chassis
                       name:=lidar_2d
                       xyz
                       rpy
                       topic:=scan
                       update_rate:=10
                       fov_deg:=270.0
                       samples:=720
                       min_range:=1.0
                       max_range:=30.0">


    <link name="${name}_link">
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://velodyne_description/meshes/HDL32E_base.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <box size="0.08 0.08 0.05"/>
        </geometry>
      </collision>
    </link>

    <joint name="${name}_joint" type="fixed">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <parent link="${parent}"/>
      <child link="${name}_link"/>
    </joint>

    <gazebo reference="${name}_link">
      <sensor name="${name}_sensor" type="ray">
        <always_on>true</always_on>
        <update_rate>${update_rate}</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>${samples}</samples>
              <resolution>1</resolution>
              <min_angle>-${fov_deg * M_PI / 360.0}</min_angle>
              <max_angle>${fov_deg * M_PI / 360.0}</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>${min_range}</min>
            <max>${max_range}</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </ray>
        <plugin name="${name}_controller" filename="libgazebo_ros_laser.so">
          <topicName>${topic}</topicName>
          <frameName>${name}_link</frameName>
        </plugin>
      </sensor>
    </gazebo>

  </xacro:macro>


  <!-- ============================================================= -->
  <!-- 3D LiDAR — outputs sensor_msgs/PointCloud2                    -->
  <!-- ============================================================= -->

  <xacro:macro name="lidar_3d"
               params="parent:=chassis
                       name:=lidar_3d
                       xyz
                       rpy
                       topic:=velodyne_points
                       lasers:=16
                       samples:=1875
                       hz:=10
                       min_range:=2.0
                       max_range:=130.0
                       gpu:=true">

    <xacro:VLP-16
        parent="${parent}"
        name="${name}"
        topic="${topic}"
        lasers="${lasers}"
        samples="${samples}"
        hz="${hz}"
        min_range="${min_range}"
        max_range="${max_range}"
        gpu="${gpu}">
      <origin xyz="${xyz}" rpy="${rpy}" />
    </xacro:VLP-16>
    
  </xacro:macro>
                    
</robot>