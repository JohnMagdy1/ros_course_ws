<sdf version='1.7'>
  <world name='default'>
    <model name='ground_plane'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
              <torsional>
                <ode/>
              </torsional>
            </friction>
            <contact>
              <ode/>
            </contact>
            <bounce/>
          </surface>
          <max_contacts>10</max_contacts>
        </collision>
      </link>
    </model>

    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

    <road name="Primary">
      <width>7.34</width>
      <point>0 0 0</point>
      <point>500 0 0</point>
      <material>
        <script>
          <uri>file://media/materials/scripts/gazebo.material</uri>
          <name>Gazebo/Primary</name>
        </script>
      </material>
    </road>

    <!-- ===== Lamp posts every 50 m, alternating sides ===== -->

    <!-- x = 0, right side -->
    <model name='lamp_post_000'>
      <static>1</static>
      <pose>0 4.5 0 0 0 0</pose>
      <link name='link'>
        <collision name='collision_pole'>
          <pose>0 0 2.5 0 0 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>5</length></cylinder></geometry>
        </collision>
        <visual name='visual_pole'>
          <pose>0 0 2.5 0 0 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>5</length></cylinder></geometry>
          <material>
            <ambient>0.25 0.25 0.25 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name='collision_arm'>
          <pose>0 -0.6 4.9 0 0 0</pose>
          <geometry><box><size>0.08 1.2 0.08</size></box></geometry>
        </collision>
        <visual name='visual_arm'>
          <pose>0 -0.6 4.9 0 0 0</pose>
          <geometry><box><size>0.08 1.2 0.08</size></box></geometry>
          <material>
            <ambient>0.25 0.25 0.25 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
        <collision name='collision_head'>
          <pose>0 -1.15 4.8 0 0 0</pose>
          <geometry><box><size>0.4 0.3 0.15</size></box></geometry>
        </collision>
        <visual name='visual_head'>
          <pose>0 -1.15 4.8 0 0 0</pose>
          <geometry><box><size>0.4 0.3 0.15</size></box></geometry>
          <material>
            <ambient>1 1 0.8 1</ambient>
            <diffuse>1 1 0.8 1</diffuse>
            <emissive>0.7 0.7 0.4 1</emissive>
          </material>
        </visual>
      </link>
      <light name='lamp_000' type='point'>
        <pose>0 -1.15 4.7 0 0 0</pose>
        <cast_shadows>1</cast_shadows>
        <diffuse>1 0.95 0.75 1</diffuse>
        <specular>0.3 0.3 0.2 1</specular>
        <attenuation>
          <range>20</range>
          <constant>0.5</constant>
          <linear>0.1</linear>
          <quadratic>0.02</quadratic>
        </attenuation>
      </light>
    </model>

